<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AppConfig>Tests.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechagroSyncServices.Shared\TechagroSyncServices.Shared.csproj" />
    <ProjectReference Include="..\HiFiSyncService\HiFiSyncService.csproj" />
    <ProjectReference Include="..\KrampSyncService\KrampSyncService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Integration tests create the database from the same procedures that are deployed to production -->
    <None Include="..\TechagroSyncServices.Shared\SQL\*.sql" Link="Integration\Database\Procedures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Integration\Database\Schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
